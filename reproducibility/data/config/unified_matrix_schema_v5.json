  "qc_levels": {
    "A": "measured label, clean sequence/editor mapping, external to evaluated model, sufficient metadata",
    "B": "measured label and clean sequence, but partial context or source-associated/possible-overlap",
    "C": "measured label but weak metadata, non-standard scale, or aggregation assumptions",
    "D": "prediction-only, annotation-only, or unclear measured label; not used for performance metrics"
  },
  "source_relation_values": [
    "external",
    "source_associated",
    "unknown_possible_overlap"
  ],
  "label_type_values": [
    "total_efficiency",
    "position_rate",
    "outcome_frequency",
    "no_edit_frequency",
    "desired_product_frequency",
    "prediction_only",
    "annotation_only"
  ],
  "task_view_policy": {
    "main_benchmark": "prefer QC A rows; source-balanced aggregation required when one source dominates row count",
    "sensitivity": "QC A plus QC B/C with explicit source and QC stratification",
    "forbidden_features": [
      "measured labels as model input",
      "measured outcome distributions as T1 input",
      "source-associated rows for primary external claims"
    ]
  }
